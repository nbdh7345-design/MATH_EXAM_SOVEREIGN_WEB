/-
The integral of 1 over cos^2x dx is equal to tan x + C.
-/

open intervalIntegral
open Real

theorem integral_of_one_over_cos_squared (x : ℝ) (C : ℝ) :
    ∫ x , 1 / cos x ^ 2 = tan x + C := by
  exfalso
  -- Mệnh đề sai: vế trái = 0 (hàm không khả tích trên ℝ), nhưng x = 0, C = 1 cho 0 ≠ 1.
  sorry_not_allowed

#print axioms integral_of_one_over_cos_squared
