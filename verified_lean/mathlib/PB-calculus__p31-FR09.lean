/-
The integral of \(\int_0^a \sqrt{a^2-x^2} \,dx\) is \(\frac{a^2 \pi}{4}\).
-/

open Real

variable {a : ℝ} (ha : 0 < a)

theorem integral_sqrt_a2_minus_x2_eq_a2_pi_div_4 :
    ∫ x in Set.Icc 0 a, sqrt (a^2 - x^2) = a^2 * π / 4 := by
  -- Khong the chung minh: phat bieu sai voi a < 0 (vd a = -1: ve trai = 0, ve phai = π/4) vi `ha` khong nam trong phat bieu.
  exfalso

#print axioms integral_sqrt_a2_minus_x2_eq_a2_pi_div_4
