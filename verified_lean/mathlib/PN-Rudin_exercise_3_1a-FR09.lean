theorem exercise_3_1a (f : ℕ → ℝ) (h : ∃ (a : ℝ), Tendsto (λ (n : ℕ) => f n) atTop (𝓝 a)) :
    ∃ (a : ℝ), Tendsto (λ (n : ℕ) => |f n|) atTop (𝓝 a) := by
  obtain ⟨a, ha⟩ := h
  exact ⟨|a|, ha.abs⟩

