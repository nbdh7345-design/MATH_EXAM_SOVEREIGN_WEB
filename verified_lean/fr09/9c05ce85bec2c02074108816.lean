theorem exercise_1_5 (A : Set ℝ) (minus_A : Set ℝ) (hA : A.Nonempty) (hA_bdd_below : BddBelow A) (hminus_A : minus_A = {x | -x ∈ A}) :
    sInf A = - sSup minus_A := by
  first
    | (norm_num; done)
    | (simp; done)
    | (field_simp; done)
    | (ring_nf; done)
    | (positivity; done)
    | (fun_prop; done)
    | (linarith; done)
    | (nlinarith; done)
    | (aesop; done)
    | (constructor <;> first | fun_prop | (norm_num; done) | (simp; done); done)

